[% INCLUDE 'doc-head-open.inc' %]
<title>kohastaffschedule</title>
[% INCLUDE 'doc-head-close.inc' %]
[% INCLUDE 'header.inc' %]

<style>
    /* Reset Koha styles within the app container to allow Tailwind to work */
    #koha-schedule-root { all: initial; font-family: sans-serif; display: block; background: #f1f5f9; min-height: 100vh; }
    #koha-schedule-root * { box-sizing: border-box; }
</style>

<div id="breadcrumbs">
    <a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo; 
    <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a> &rsaquo; 
    kohastaffschedule
</div>

<div id="koha-schedule-root"></div>

<script>
    window.KohaScheduleConfig = {
        branches: [
            [% FOREACH b IN branches %]
                { id: "[% b.branchcode %]", name: "[% b.branchname %]" },
            [% END %]
            { id: "OUT", name: "Out" } 
        ],
        staff: [
            [% FOREACH p IN staff %]
                { id: "[% p.borrowernumber %]", name: "[% p.firstname %] [% p.surname %]" },
            [% END %]
        ],
        isAdmin: [% is_admin ? 'true' : 'false' %],
        currentUser: "[% userid %]",
        apiUrl: '/api/v1/contrib/kohastaffschedule/'
    };
</script>

<script src="[% c.asset_url('bundle.js') %]"></script>

[% INCLUDE 'intranet-bottom.inc' %]
